# ===== Frontend environment — copy file này thành `.env` rồi chỉnh theo môi trường =====
# Biến phải có prefix VITE_ thì Vite mới nhúng vào bundle client. File .env KHÔNG commit.

# --- API ---
VITE_API_BASE_URL=http://localhost:5080/api

# --- Hiển thị ---
VITE_APP_NAME=Invento

# --- Lưu phiên đăng nhập (key trong localStorage) ---
VITE_TOKEN_KEY=invento_token
VITE_USER_KEY=invento_user
VITE_EXPIRES_AT_KEY=invento_expires_at

# --- UI ---
VITE_TOAST_DURATION_MS=5000
VITE_PAGE_SIZE=7

# --- Dev server ---
VITE_DEV_PORT=5173
