# ===== Backend environment — copy file này thành `.env` rồi chỉnh theo môi trường =====
# Biến dùng dấu __ kép để map lồng nhau: Jwt__Key => "Jwt": { "Key": ... }
# Giá trị trong .env sẽ OVERRIDE appsettings.json. File .env KHÔNG commit.

# --- Server ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Database ---
ConnectionStrings__DefaultConnection=Server=localhost;Database=InventoDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False
Database__AutoCreate=true

# --- JWT ---
Jwt__Issuer=Inventory_Man_Sys_Be
Jwt__Audience=Invento.Frontend
Jwt__Key=LOCAL_DEVELOPMENT_ONLY_CHANGE_THIS_KEY_2026_InventorySystem
Jwt__ExpiryHours=8

# --- CORS (cho phép frontend nào gọi API) ---
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173

# --- Security ---
Security__LoginRateLimit=5
Security__LoginRateWindowSeconds=60

# --- Seed (chỉ chạy khi bảng Users rỗng) ---
Seed__AdminName=Rakib Kowshar
Seed__AdminEmail=admin@invento.local
Seed__AdminPassword=Inventory123!
Seed__StaffName=Alex Nguyen
Seed__StaffEmail=staff@invento.local
Seed__StaffPassword=Inventory123!

# --- Logging ---
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
